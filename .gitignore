#---------------------------------------------------------------------
# Secrets and credentials  --  NEVER commit these
#---------------------------------------------------------------------
.env
.env.*
!.env.example

# Leftover config holding live production DB credentials (Aiven).
# CodeIgniter never loads it; safest is to delete the file entirely.
app/Config/_database.php

# WordPress DB credentials + auth salts
blog/wp-config.php

# I'm removing whole WP section from repo. Remove this line if you don't want to do this.
blog/

#---------------------------------------------------------------------
# Database dumps and archives
#---------------------------------------------------------------------
# Contains real user data (PII) -- keep it out of the repo.
*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.bak
*.bak-*

#---------------------------------------------------------------------
# Dependencies (restore with `composer install`)
#---------------------------------------------------------------------
/vendor/
node_modules/
npm-debug.log
yarn-error.log
package-lock.json.bak

#---------------------------------------------------------------------
# CodeIgniter writable/ -- keep the folder structure, drop the contents
#---------------------------------------------------------------------
writable/cache/*
!writable/cache/index.html

writable/logs/*
!writable/logs/index.html

writable/session/*
!writable/session/index.html

writable/uploads/*
!writable/uploads/index.html

writable/debugbar/*
!writable/debugbar/index.html

php_errors.log
*.log

#---------------------------------------------------------------------
# Uploaded media (user-generated content, ~95 MB)
# Remove this block if you want the images committed to the repo.
#---------------------------------------------------------------------
/public/uploads/
/uploads/
/blog/wp-content/uploads/

#---------------------------------------------------------------------
# WordPress runtime
#---------------------------------------------------------------------
blog/wp-content/cache/
blog/wp-content/upgrade/
blog/wp-content/upgrade-temp-backup/
blog/wp-content/backup*/
blog/wp-content/ai1wm-backups/
blog/wp-content/blogs.dir/
blog/wp-content/uploads-*/

# Drop-ins generated by caching / debug plugins
blog/wp-content/advanced-cache.php
blog/wp-content/object-cache.php
blog/wp-content/db.php
blog/error_log

#---------------------------------------------------------------------
# Build / scratch
#---------------------------------------------------------------------
/temp_assets/
/results/
/phpunit*.xml
!/phpunit.xml.dist
.phpunit.cache/
.phpunit.result.cache
/.php-cs-fixer.php
/.php-cs-fixer.cache

#---------------------------------------------------------------------
# Editors and IDEs
#---------------------------------------------------------------------
/.idea/
*.iml
/.vscode/
/nbproject/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

#---------------------------------------------------------------------
# OS cruft
#---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
